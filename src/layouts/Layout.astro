---
import Head from "../components/Head.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import ThemeManager from "../components/reactive/ThemeManager.svelte";

interface Props {
  siteTitle: string;
  siteDescription: string;
  headerCosmeticText: string;
}

const { siteTitle, siteDescription, headerCosmeticText } = Astro.props;
---

<!doctype html>
<html lang="en" class="bg-primary">
  <head>
    <Head pageTitle={siteTitle} pageDescription={siteDescription} />
  </head>
  <body>
    <!-- Theme Manager handles occasion canvas particles & syncs theme/favicon -->
    <ThemeManager client:load />

    <main class="relative z-10 min-h-svh">
      <Header cosmeticText={headerCosmeticText} />
      <slot />
      <Footer />
    </main>
  </body>
</html>
